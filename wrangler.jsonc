{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-webdav",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cf-webdav-r2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ACCOUNTS_KV",
      "id": "b46bf22fe2b042cd899593052e0da7b0"
    },
    {
      "binding": "LOCKS_KV",
      "id": "565759437af24a679af98a656e98a799"
    },
    {
      "binding": "ADMIN_KV",
      "id": "074a6dee1be849b994fcd3d150105d7c"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_CSRF",
        "class_name": "AdminCsrf"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AdminCsrf"]
    }
  ],
  "vars": {
    "CHUNK_SIZE_MB": 4,
    "PBKDF2_ITERATIONS": 100000,
    "AUTH_CACHE_TTL_SECONDS": 60,
    "PROPFIND_MAX_ENTRIES": 5000,
    "LOCK_TIMEOUT_SECONDS": 3600,
    "MAX_PUT_BYTES": 524288000
  }
}
